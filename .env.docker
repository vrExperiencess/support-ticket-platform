# =====================================================
# Support Ticket Platform
# Docker evaluation environment
# =====================================================

NODE_ENV=production
PORT=3000

# =====================================================
# PostgreSQL container initialization
# =====================================================

POSTGRES_DB=support_ticket_db
POSTGRES_USER=support_user
POSTGRES_PASSWORD=support_password

# =====================================================
# NestJS -> PostgreSQL
# =====================================================

DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_NAME=support_ticket_db
DATABASE_USER=support_user
DATABASE_PASSWORD=support_password

# Only enabled for the disposable Docker demo environment.
# Production should use migrations instead.
DATABASE_SYNCHRONIZE=true

# =====================================================
# Authentication
# =====================================================

JWT_SECRET=support-ticket-platform-demo-jwt-secret
JWT_EXPIRES_IN=8h

# =====================================================
# Frontend
# =====================================================

FRONTEND_URL=http://localhost:8080,http://localhost:5173